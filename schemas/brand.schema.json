{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "brand/brand.yml",
  "description": "The Servio brand system: identity, services, pricing, audience, voice, visual identity and the hard avoid-list. Every generated post is grounded in this file.",
  "$comment": "The top level deliberately allows extra fields (additionalProperties: true) so the owner can add new brand sections without breaking validation. The sections the pipeline relies on are typed precisely below.",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "website", "tagline", "services", "pricing", "audience", "voice", "avoid"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "website": { "type": "string", "pattern": "^https://", "$comment": "Must be a secure https:// link." },
    "tagline": { "type": "string", "minLength": 1 },
    "tagline_alt": { "type": "string" },
    "description": { "type": "string" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slug"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "$comment": "Matches the service detail page at /services/<slug> on the website."
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plans"],
      "properties": {
        "rule": { "type": "string" },
        "currency": { "type": "string" },
        "plans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "price"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "price": { "type": "string", "minLength": 1, "$comment": "Kept as text so currency symbols and Indian digit grouping stay exactly as written." }
            }
          }
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "who": { "type": "array", "items": { "type": "string" } },
        "pain_points": { "type": "array", "items": { "type": "string" } }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "personality": { "type": "string" },
        "style": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "colors": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "fonts": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "blog": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "base_url": { "type": "string", "pattern": "^https://" },
        "slugs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } }
      }
    },
    "avoid": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "$comment": "Hard rules. The generation prompts quote these verbatim to the AI writer."
    }
  }
}
