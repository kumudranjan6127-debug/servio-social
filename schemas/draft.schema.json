{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "drafts/<id>/post.yml",
  "description": "One generated content pack awaiting approval: the per-platform post texts, hashtags, image details and status. Produced by the Phase 1 pipeline; the schema is defined now so validation is ready on day one.",
  "$comment": "The category and platform enums here intentionally mirror calendar.schema.json - keep them in sync if either ever changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "generated_at", "model", "topic", "category", "cta", "platforms"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$",
      "$comment": "Same id as the calendar entry the draft came from. Must equal the draft's folder name - the validator cross-checks this."
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "model": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["education", "portfolio", "service", "case-study", "pain-point", "holiday", "campaign"]
    },
    "cta": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "$comment": "Must exist as a key in brand/ctas.yml - the validator cross-checks this."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt"],
      "$comment": "Omit the whole section for text-only posts. Note: Instagram cannot post without an image.",
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1, "$comment": "Screen-reader description of the image." },
        "headline": { "type": "string" }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "$comment": "Each platform layers its own hard character limit on top of the shared platformPost shape. src/validate.ts repeats these checks with friendlier messages; keep both in sync.",
      "properties": {
        "linkedin": {
          "allOf": [
            { "$ref": "#/definitions/platformPost" },
            { "properties": { "text": { "maxLength": 3000 } } }
          ]
        },
        "x": {
          "allOf": [
            { "$ref": "#/definitions/platformPost" },
            { "properties": { "text": { "maxLength": 280 } } }
          ]
        },
        "instagram": {
          "allOf": [
            { "$ref": "#/definitions/platformPost" },
            { "properties": { "text": { "maxLength": 2200 } } }
          ]
        },
        "facebook": {
          "allOf": [
            { "$ref": "#/definitions/platformPost" },
            { "properties": { "text": { "maxLength": 63206 } } }
          ]
        }
      }
    },
    "hashtags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linkedin": { "$ref": "#/definitions/hashtagList" },
        "x": { "$ref": "#/definitions/hashtagList" },
        "instagram": { "$ref": "#/definitions/hashtagList" },
        "facebook": { "$ref": "#/definitions/hashtagList" }
      }
    },
    "research_notes": { "type": "string", "$comment": "Optional prose from the research call, kept for the human reviewer." }
  },
  "definitions": {
    "platformPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "status"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "approved", "published", "failed", "skipped"] },
        "url": { "type": "string", "$comment": "Filled in after publishing: the live link to the post." },
        "error": { "type": ["string", "null"], "$comment": "Filled in if publishing failed, so the reviewer can see why." }
      }
    },
    "hashtagList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
