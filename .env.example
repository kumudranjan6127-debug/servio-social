# .env.example — every environment variable servio-social understands.
# This file mirrors src/config/env.ts exactly. It documents NAMES only —
# never write a real value into this file or any other file in this repo.
#
# Where real values live:
#   - GitHub Actions: repo Settings > Secrets and variables > Actions
#     (docs/SETUP.md explains where each value comes from).
#   - Local runs: copy this file to `.env` (git-ignored) and fill it there.
# If a key is ever pasted into a chat, email, or document, treat it as leaked
# and regenerate it at its source.

# =====================================================================
# REQUIRED — the run refuses to start without these four.
# =====================================================================

# Google Gemini API key. This is the AI that writes all the content.
# Get one at https://aistudio.google.com (Get API key). A key separate from
# any other project's is recommended so usage and rotation stay independent.
GEMINI_API_KEY=

# Buffer API key. Buffer is the service that actually publishes the posts.
# One key covers every channel connected to the Buffer account.
BUFFER_API_KEY=

# The Buffer channel ids of the two destinations. To find them, set only
# BUFFER_API_KEY and run `npm run channels` — it prints a table of every
# connected channel's id, name, and service. Copy the ids from there.
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=

# =====================================================================
# OPTIONAL — image hosting. Buffer only accepts PUBLIC image URLs, so the
# local branded image must be uploaded somewhere first. Cloudinary's free
# unsigned-upload does that. If these two are empty, posts go out without
# an image and Instagram (which requires one) is SKIPPED — not failed.
# =====================================================================

# Your Cloudinary cloud name (Cloudinary dashboard, top of the page).
CLOUDINARY_CLOUD_NAME=

# The name of an UNSIGNED upload preset (Cloudinary Settings > Upload).
CLOUDINARY_UPLOAD_PRESET=

# =====================================================================
# OPTIONAL — AI image generation. When configured, each post gets a bespoke
# professional image generated from that day's image prompt instead of the
# static branded pool. The result still goes through Cloudinary (above) so
# Buffer gets a public URL. Order used: Cloudflare (free) -> fal.ai (paid) ->
# branded pool. Any failure falls through to the next automatically.
# =====================================================================

# --- Cloudflare Workers AI (FREE — recommended). Make a free account at
# dash.cloudflare.com, then: Account ID is on the right of the dashboard home;
# create an API token (My Profile > API Tokens) with the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model. Default: @cf/black-forest-labs/flux-1-schnell (free, fast, good).
CLOUDFLARE_IMAGE_MODEL=

# --- fal.ai (PAID — a few cents per image). Only used if Cloudflare is not set.
# Key from fal.ai dashboard > Keys (looks like "id:secret").
FAL_KEY=
# Default: fal-ai/flux/dev. Others: fal-ai/flux/schnell, fal-ai/flux-pro/v1.1,
# fal-ai/recraft-v3.
FAL_IMAGE_MODEL=

# =====================================================================
# OPTIONAL — behavior switches. All have safe defaults; leave empty
# unless you want to change something.
# =====================================================================

# "true" (or "1") = rehearsal mode: the whole pipeline runs and every payload
# is logged, but NOTHING is sent to Buffer and no history record is saved.
DRY_RUN=

# Which Gemini model writes the content. Default: gemini-flash-latest
# (an alias that always tracks the current flash model, so it never retires).
# To see the exact models your key can call, run `npm run models`. Pinned
# versions like gemini-2.5-flash can return 404 "no longer available".
GEMINI_MODEL=

# 0..1 — if a new post is more similar than this to a recent post, it is
# rejected and regenerated. Default: 0.7
SIMILARITY_THRESHOLD=

# 1..5 — how many regeneration attempts (after the first draft is rejected)
# before the run gives up and fails. Default: 3
MAX_REGEN_ATTEMPTS=

# A Slack/Discord-compatible webhook URL. After every run it receives a small
# JSON message ({"text": "..."}) saying what happened — success or failure.
# Leave empty for no notifications.
NOTIFY_WEBHOOK_URL=

# How chatty the logs are: debug | info | warn | error. Default: info
LOG_LEVEL=
