# .env.example — NAMES of the secrets this system uses. No real values, ever.
#
# This file is documentation only. The real values live in GitHub → repo Settings →
# Secrets and variables → Actions (see docs/SETUP.md, section H, for where each
# value comes from). Never write a real key into this file or any other file in
# this repo. If you run anything locally, copy this file to `.env` (which git
# ignores) and fill values there.

# --- The AI writer (needed from Phase 1) ---
ANTHROPIC_API_KEY=          # Claude API key from console.anthropic.com — starts with sk-ant-

# --- X / Twitter (Phase 2) — the four OAuth 1.0a values, none of them expire ---
X_API_KEY=                  # X app "API Key" (Consumer Keys section of the developer console)
X_API_SECRET=               # X app "API Key Secret" (shown once — regenerate if lost)
X_ACCESS_TOKEN=             # X account "Access Token" (must be generated AFTER Read+Write is set)
X_ACCESS_SECRET=            # X account "Access Token Secret" (regenerate together with the token)

# --- LinkedIn, personal profile (Phase 2) ---
LINKEDIN_ACCESS_TOKEN=      # Posting token (~60 days; renew by hand — health check warns at day 45)
LINKEDIN_AUTHOR_URN=        # Your profile's ID, looks like urn:li:person:AbC12dEfG3

# --- Facebook Page (Phase 2) ---
FB_PAGE_ID=                 # The Servio Facebook Page's ID number (not secret, but kept here)
META_SYSTEM_USER_TOKEN=     # Never-expiring system-user token from Meta Business Suite

# --- Instagram (Phase 2) ---
IG_USER_ID=                 # The Instagram Business account's ID number
IG_ACCESS_TOKEN=            # Instagram posting token (60 days; the weekly health check auto-renews it)

# --- Image hosting (Phase 2) ---
CLOUDINARY_URL=             # Full cloudinary://... string from the existing Servio Cloudinary dashboard

# --- GitHub housekeeping (Phase 2) ---
GH_PAT_SECRETS_WRITE=       # Fine-grained GitHub token (this repo only, Secrets: read+write) so the
                            # health check can save the renewed Instagram token by itself
