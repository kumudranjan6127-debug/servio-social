# .env.example — NAMES of the secrets this system uses. No real values, ever.
#
# This file is documentation only. The real values live in GitHub → repo Settings →
# Secrets and variables → Actions (see docs/SETUP.md for where each value comes
# from). Never write a real key into this file or any other file in this repo.
# If a key is ever pasted into a chat, email, or document, treat it as leaked:
# regenerate it at its source before storing the new one in GitHub Secrets.
# If you run anything locally, copy this file to `.env` (git-ignored) and fill
# values there.

# --- The AI writer (needed from Phase 1) ---
GEMINI_API_KEY=             # Google AI Studio key (aistudio.google.com). A separate key from the
                            # website's is recommended so usage and rotation stay independent.

# --- The publisher (needed from Phase 2) ---
BUFFER_ACCESS_TOKEN=        # Buffer API access token. One token covers every connected channel
                            # (LinkedIn Company Page, Instagram, and any added later).

# ---------------------------------------------------------------------------
# FALLBACK PATH ONLY — direct platform APIs. Not needed while publisher: buffer.
# The full runbooks for these live in git history and docs/SETUP.md's appendix.
#   X_API_KEY / X_API_SECRET / X_ACCESS_TOKEN / X_ACCESS_SECRET
#   LINKEDIN_ACCESS_TOKEN / LINKEDIN_AUTHOR_URN
#   FB_PAGE_ID / META_SYSTEM_USER_TOKEN
#   IG_USER_ID / IG_ACCESS_TOKEN
#   CLOUDINARY_URL
#   GH_PAT_SECRETS_WRITE
# ---------------------------------------------------------------------------
