# Installed packages (recreated any time with "npm install")
node_modules/

# Environment files may contain secrets - never commit them.
# The example file is safe: it documents variable NAMES only, no values.
.env*
!.env.example

# Defense-in-depth: never accidentally commit a credential file, even one no
# code references. These names cover the usual private keys, cloud
# service-account JSON, and personal npm/registry auth.
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.keystore
credentials.json
gha-creds-*.json
service-account*.json
secrets/
.npmrc

# Run logs are written on every run and never committed. CI uploads them as an
# ephemeral build artifact (retained 14 days), so they stay out of the public
# git history entirely; local run logs are kept out the same way.
logs/

# Build output (this project has none today, but just in case)
dist/

# OS clutter
.DS_Store
