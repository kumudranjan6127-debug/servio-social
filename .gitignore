# Installed packages (recreated any time with "npm install")
node_modules/

# Environment files may contain secrets - never commit them.
# The example file is safe: it documents variable NAMES only, no values.
.env*
!.env.example

# Run logs are written on every local run. The GitHub Actions workflow
# force-adds logs/ (git add -f) when it commits run results back, so CI
# run logs ARE still preserved in the repo history - only local ones are
# kept out.
logs/

# Build output (this project has none today, but just in case)
dist/

# OS clutter
.DS_Store
