{
  "name": "servio-social",
  "description": "Fully-automatic AI social pipeline for Servio: Gemini writes, Buffer publishes to LinkedIn + Instagram, GitHub Actions runs it daily at 09:00 IST.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "channels": "tsx src/buffer/getChannels.ts",
    "models": "tsx src/ai/listModels.ts",
    "gemini-image": "tsx src/ai/probeImageModels.ts",
    "cloudinary": "tsx src/buffer/testUpload.ts",
    "health": "tsx src/index.ts --health",
    "generate:week": "tsx src/index.ts --week",
    "images": "node scripts/generate-brand-images.mjs"
  },
  "dependencies": {
    "axios": "^1",
    "dotenv": "^17",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^26",
    "eslint": "^9",
    "globals": "^16",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
